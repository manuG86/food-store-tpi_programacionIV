# Copiar a .env y ajustar la conexión a la base PostgreSQL del TPI.
DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/food_store_tpi

# Generar una clave local con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=completar-con-una-clave-aleatoria-de-32-caracteres-o-mas
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Usar el mismo hostname para frontend y API en el navegador.
FRONTEND_ORIGIN=http://localhost:5173
